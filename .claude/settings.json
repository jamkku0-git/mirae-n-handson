{
  "permissions": {
    "allow": [
      "Bash(./gradlew test *)",
      "Bash(npm test *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/scripts/hook-node.sh .claude/hooks/eslint-web.mjs",
            "timeout": 60,
            "statusMessage": "eslint (modern/web)"
          }
        ]
      }
    ]
  }
}
